---
import { regions } from '../../regions.config.mjs';
const names = regions.map((r) => r.name.en).join(', ');
const base = import.meta.env.BASE_URL;
// Версия данных каждого региона (дата сборки + размер) — в URL файлов, чтобы кэш service worker не отдал старый формат.
const metas = import.meta.glob<{ built: string; bytes: number }>('../../public/data/*/meta.json', { eager: true, import: 'default' });
const dataV = Object.fromEntries(Object.entries(metas).map(([p, m]) => [p.split('/').at(-2), `${m.built}-${m.bytes}`]));
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Quiet Index — Индекс тихого места</title>
    <meta name="description" content={`How quiet, dark and remote is any point in ${names}? Roads, night lights, population, land cover — open data, computed in your browser. · Насколько тихо, темно и безлюдно в любой точке: дороги, ночной свет, население, природа — открытые данные, расчёт в браузере.`} />
    <meta name="theme-color" content="#fbfaf7" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Quiet Index — where it is quiet, dark and empty" />
    <meta property="og:description" content={`Score any point of ${names} from 0 to 100: roads, night lights, population, land cover. Open data, computed in your browser.`} />
    <meta property="og:image" content={`${Astro.site ?? ''}${base}og.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Данные региона из ?r= начинают грузиться до разбора скрипта. -->
    <script is:inline define:vars={{ base, ids: regions.map((r) => r.id), dataV }}>
      const r = new URL(location.href).searchParams.get('r');
      const id = ids.includes(r) ? r : ids[0];
      for (const f of ['scores.gz', 'meta.json']) { const l = document.createElement('link'); l.rel = 'preload'; l.as = 'fetch'; l.crossOrigin = 'anonymous'; l.href = `${base}data/${id}/${f}?v=${dataV[id] ?? ''}`; document.head.append(l); }
    </script>
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link rel="apple-touch-icon" href={`${base}icons/icon-192.png`} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='14' fill='%232f8a72'/%3E%3Ccircle cx='16' cy='16' r='6' fill='%23fbfaf7'/%3E%3C/svg%3E" />
  </head>
  <body data-sheet="peek" data-v={JSON.stringify(dataV)}>
    <div id="map" class="map" role="region" data-i-aria="mapAria"></div>

    <div class="legend-box">
      <b class="legend-title"></b>
      <i class="legend-bar"></i>
      <span class="legend-ticks"><small class="legend-min"></small><small class="legend-max"></small></span>
    </div>

    <aside class="panel">
      <button class="sheet-handle" type="button" data-i-aria="expand" aria-expanded="false"></button>
      <header class="brand">
        <h1>Quiet Index</h1>
        <select class="region" data-i-aria="region"></select>
        <a class="lang" href="?lang=en" hreflang="en">EN</a>
      </header>
      <p class="tagline" data-i="tagline"></p>

      <div class="search-row">
      <div class="search-wrap">
        <input class="search" type="search" data-i-ph="searchPh" data-i-aria="searchPh" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="search-results" />
        <div class="search-results" id="search-results" role="listbox" hidden></div>
      </div>
      <button class="locate" type="button" data-i="locate"></button>
      </div>
      <p class="geo-error note" role="alert" hidden data-i="geoError"></p>
      <p class="offline-note note" data-i="offline"></p>

      <div class="views" role="radiogroup"></div>

      <p class="loading" aria-live="polite" data-i="loading"></p>

      <section class="empty" hidden>
        <p class="lead" data-i="lead"></p>
        <h2 class="sect" data-i="examples"></h2>
        <div class="examples"></div>
      </section>
      <section class="outside" hidden><p class="lead" data-i="outside"></p></section>

      <section class="result" hidden>
        <div class="score-box">
          <b class="score"></b><span class="score-of" data-i="of100"></span>
          <span class="verdict"></span>
        </div>
        <p class="place"></p>
        <ul class="breakdown"></ul>
        <div class="actions"><button class="copy-link" type="button" data-i="copyLink"></button><button class="compare-btn" type="button" data-i="compareBtn"></button></div>
        <div class="compare" hidden>
          <h2 class="sect" data-i="compareTitle"></h2>
          <p class="compare-hint note" data-i="compareHint" hidden></p>
          <table class="compare-table"><tbody></tbody></table>
          <button class="compare-clear" type="button" data-i="compareClear"></button>
        </div>
        <div class="spots">
          <h2 class="sect" data-i="spots"></h2>
          <div class="spots-radius" role="radiogroup"></div>
          <ol class="spots-list"></ol>
        </div>
      </section>

      <section class="weights">
        <h2 class="sect" data-i="weights"></h2>
        <div class="weights-list"></div>
        <p class="note" data-i="weightsNote"></p>
        <button class="reset" type="button" data-i="reset"></button>
      </section>

      <details class="about">
        <summary data-i="aboutTitle"></summary>
        <p data-i="about"></p>
        <p class="built"></p>
      </details>
    </aside>

    <script src="../scripts/main.ts"></script>
  </body>
</html>
